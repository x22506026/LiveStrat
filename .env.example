# Copy this file to ".env" and fill in the values you want before running the app.

# Used by Flask to sign session cookies. Pick anything for local development.
SECRET_KEY=change-me-to-anything-for-local-dev

# Connection string for the Postgres container that docker compose starts.
# Leave this as it is unless you are pointing at a different database.
DATABASE_URL=postgresql+psycopg2://livestrat:livestrat_password@localhost:5432/livestrat

# Telegram delivery is optional. Leave these blank and in-app notifications
# will still work. Fill them in only if you want alerts pushed to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
